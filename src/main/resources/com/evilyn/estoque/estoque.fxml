<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="450.0" prefWidth="700.0" style="-fx-background-color: #F4EDE7;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.evilyn.estoque.controller.EstoqueController">
   <top>
      <VBox prefHeight="124.0" prefWidth="700.0" style="-fx-background-color: #F4EDE7;" BorderPane.alignment="CENTER">
         <children>
            <Label text="Produtos em estoque" textFill="#8451a6">
               <font>
                  <Font name="Arial Bold Italic" size="18.0" />
               </font>
               <padding>
                  <Insets bottom="10.0" left="20.0" right="10.0" top="20.0" />
               </padding>
            </Label>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" style="-fx-background-color: #F4EDE7;">
               <children>
                  <TextField fx:id="campoBusca" layoutX="18.0" layoutY="22.0" prefHeight="29.0" prefWidth="239.0" />
                  <Button fx:id="btnAdicionar" layoutX="275.0" layoutY="24.0" mnemonicParsing="false" onAction="#adicionarProduto" prefHeight="25.0" prefWidth="87.0" style="-fx-background-color: #8451a6;" text="Adicionar" textFill="WHITE" />
                  <Button fx:id="btnEditar" layoutX="371.0" layoutY="24.0" mnemonicParsing="false" onAction="#editarProduto" prefHeight="25.0" prefWidth="87.0" style="-fx-background-color: #8451a6;" text="Editar" textFill="WHITE" />
                  <Button fx:id="btnRemover" layoutX="472.0" layoutY="24.0" mnemonicParsing="false" onAction="#removerProduto" prefHeight="25.0" prefWidth="87.0" style="-fx-background-color: #8451a6;" text="Remover" textFill="WHITE" />
                  <Button layoutX="571.0" layoutY="24.0" mnemonicParsing="false" onAction="#aoVoltarMenu" prefHeight="25.0" prefWidth="87.0" style="-fx-background-color: #8451a6;" text="Voltar" textFill="WHITE" />
               </children>
            </AnchorPane>
         </children>
      </VBox>
   </top>
   <center>
      <TableView fx:id="tabelaProdutos" prefHeight="276.0" prefWidth="192.0" style="-fx-background-color: fff;" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colunaId" prefWidth="113.0" style="fx-background-color: #8451a6;" text="ID" />
          <TableColumn fx:id="colunaNome" prefWidth="171.0" text="Nome" />
            <TableColumn fx:id="colunaCategoria" prefWidth="152.0" text="Categoria" />
            <TableColumn fx:id="colunaQuantidade" prefWidth="139.0" text="Quantidade" />
            <TableColumn fx:id="colunaPreco" minWidth="6.0" prefWidth="94.0" text="Preço" />
        </columns>
         <BorderPane.margin>
            <Insets bottom="30.0" left="20.0" right="10.0" top="20.0" />
         </BorderPane.margin>
      </TableView>
   </center>
</BorderPane>
